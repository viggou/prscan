// prscan — network scanner library
//
// Usage:
//   use "prscan"
//
//   let results = prscan.scan("192.168.1.0/24", {timeout: 1500})
//   let host = prscan.scanHost("192.168.1.1", 1500)
//
// Each result is a map: {ip, hostname, domain, mac, status}
// status is "up" or "down"

use "hex"
use "arp"

// ── NetBIOS NBSTAT packet ──

let NBSTAT_QUERY = bytes.from([
    0xA0, 0x00,       // Transaction ID
    0x00, 0x00,       // Flags: query
    0x00, 0x01,       // Questions: 1
    0x00, 0x00,       // Answer RRs
    0x00, 0x00,       // Authority RRs
    0x00, 0x00,       // Additional RRs
    0x20,             // Name length (32 encoded bytes)
    0x43, 0x4B,       // "* " encoded
    0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
    0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
    0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
    0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
    0x00,             // Name terminator
    0x00, 0x21,       // Type: NBSTAT
    0x00, 0x01        // Class: IN
])

// ── IP range parsing ──

func parseRange(input) {
    if (input.contains("/")) { return parseCIDR(input) }
    if (!input.contains("-")) { return [input] }

    let parts = input.split("-")
    let startIp = ipToInt(parts[0].strip())
    let endPart = parts[1].strip()
    let endIp = endPart.contains(".")
        ? ipToInt(endPart)
        : ipToInt(parts[0].strip().split(".").slice(0, 3).join(".") + "." + endPart)
    return generateRange(startIp, endIp)
}

func ipToInt(ip) {
    let p = ip.split(".")
    return num(p[0]) * 16777216 + num(p[1]) * 65536 + num(p[2]) * 256 + num(p[3])
}

func intToIp(n) {
    return str(math.floor(n / 16777216) % 256) + "." +
           str(math.floor(n / 65536) % 256) + "." +
           str(math.floor(n / 256) % 256) + "." +
           str(n % 256)
}

func parseCIDR(cidr) {
    let parts = cidr.split("/")
    let hostBits = 32 - num(parts[1])
    let numHosts = 1 << hostBits
    let networkAddr = ipToInt(parts[0]) & ~(numHosts - 1)
    return generateRange(networkAddr + 1, networkAddr + numHosts - 2)
}

func generateRange(startInt, endInt) {
    let ips = []
    for (i in startInt..endInt + 1) { push(ips, intToIp(i)) }
    return ips
}

// ── NetBIOS response parsing ──

func parseNBSTATResponse(data) {
    let raw = bytes.toArray(data)
    if (len(raw) < 57) { return nil }

    let nameCount = raw[56]
    let names = []
    let offset = 57

    for (i in 0..nameCount) {
        if (offset + 18 > len(raw)) { break }
        let nameBytes = []
        for (j in 0..15) { push(nameBytes, raw[offset + j]) }
        let nameType = raw[offset + 15]
        let flags = raw[offset + 16] * 256 + raw[offset + 17]
        let isGroup = (flags & 0x8000) != 0

        let name = ""
        for (b in nameBytes) {
            if (b >= 32 && b <= 126) { name = name + fromCharCode(b) }
        }
        name = name.strip()

        if (len(name) > 0) {
            push(names, {name: name, group: isGroup, suffix: nameType})
        }
        offset = offset + 18
    }

    let mac = ""
    if (offset + 6 <= len(raw)) {
        let macParts = []
        for (j in 0..6) { push(macParts, hex.fromInt(raw[offset + j], 2)) }
        mac = macParts.join(":")
    }

    let hostname = names.find(lam{ e in e.suffix == 0 && !e.group })?.name ?? ""
    let domain = names.find(lam{ e in e.suffix == 0 && e.group })?.name ?? ""

    return {hostname: hostname, domain: domain, mac: mac, names: names}
}

// ── Single-host scanning (kept for backward compat) ──

func scanHost(ip, timeout = 1500, iface = nil) {
    let result = {ip: ip, hostname: "", domain: "", mac: "", status: "down"}

    // Try NetBIOS NBSTAT query
    let sock = nil
    try {
        sock = net.udp()
        if (iface) { net.bindInterface(sock, iface) }
        net.setTimeout(sock, timeout)
        net.sendTo(sock, ip, 137, NBSTAT_QUERY)
        let resp = net.recvFrom(sock)
        net.close(sock)
        sock = nil

        if (resp) {
            let info = parseNBSTATResponse(resp.data)
            if (info) {
                result.hostname = info.hostname
                result.domain = info.domain
                result.mac = info.mac
                result.status = "up"
            }
        }
    } catch (e) {
        if (sock) { try { net.close(sock) } catch (e2) {} }
        if (str(e) == "Interrupted") { throw e }
    }

    // If no NetBIOS response, try reverse DNS
    if (result.hostname == "") {
        try {
            let records = net.query(ip, "PTR")
            if (len(records) > 0) {
                result.hostname = records[0].hostname
                result.status = "up"
            }
        } catch (e) {
            if (str(e) == "Interrupted") { throw e }
        }
    }

    // Try ARP for MAC if we don't have it
    if (result.status == "up" && (result.mac == "" || result.mac == "00:00:00:00:00:00")) {
        result.mac = ""
        try {
            // Ping to populate ARP cache, then look up
            try { net.ping(ip, 500) } catch (e) {}
            let entry = arp.lookup(ip)
            if (entry) {
                result.mac = entry.mac
                if (result.hostname == "" && entry.hostname != "") {
                    result.hostname = entry.hostname
                }
            }
        } catch (e) {
            if (str(e) == "Interrupted") { throw e }
        }
    }

    return result
}

// ── Concurrent scanning ──
// Scans all IPs in two concurrent phases, then iterates hosts for enrichment:
//   Phase 1: ICMP ping sweep (net.pingAll) — find alive hosts
//   Phase 2: NetBIOS NBSTAT sweep — send all queries, collect responses
//   Per-host: PTR lookup + ARP enrichment (only for alive hosts)
//
// onResult(result, index) is called for each host in order after enrichment.
// onDiscovery(pingFailed) is called when phases 1+2 complete.
// Returns array of all results.

func scanAll(ips, timeout = 1500, iface = nil, onResult = nil, onDiscovery = nil) {
    let results = {}
    for (ip in ips) {
        results[ip] = {ip: ip, hostname: "", domain: "", mac: "", status: "down"}
    }

    let pingFailed = false

    // ── Phase 1: ICMP ping sweep ──
    try {
        let pings = net.pingAll(ips, timeout)
        for (p in pings) {
            if (p.alive) { results[p.host].status = "up" }
        }
    } catch (e) {
        if (str(e) == "Interrupted") { throw e }
        pingFailed = true
    }

    // ── Phase 2: NetBIOS NBSTAT sweep ──
    let sock = nil
    try {
        sock = net.udp()
        if (iface) { net.bindInterface(sock, iface) }
        net.setTimeout(sock, 100)

        for (ip in ips) {
            net.sendTo(sock, ip, 137, NBSTAT_QUERY)
        }

        let start = time.now()
        while (time.now() - start < timeout) {
            let resp = net.recvFrom(sock)
            if (!resp) { continue }
            let info = parseNBSTATResponse(resp.data)
            if (info && results.has(resp.host)) {
                let r = results[resp.host]
                r.hostname = info.hostname
                r.domain = info.domain
                r.mac = info.mac
                r.status = "up"
            }
        }
        net.close(sock)
        sock = nil
    } catch (e) {
        if (sock) { try { net.close(sock) } catch (e2) {} }
        if (str(e) == "Interrupted") { throw e }
    }

    // ── Phase 2b: TCP connect fallback when ping is unavailable ──
    if (pingFailed) {
        try {
            let targets = ips
                |> filter(lam{ ip in results[ip].status == "down" })
                |> map(lam{ ip in {host: ip, port: 445} })
            if (len(targets) > 0) {
                let tcpResults = net.connectAll(targets, timeout)
                for (r in tcpResults) {
                    if (r.open) { results[r.host].status = "up" }
                }
            }
        } catch (e) {
            if (str(e) == "Interrupted") { throw e }
        }
    }

    if (onDiscovery) { onDiscovery(pingFailed) }

    // ── Fetch ARP table once for MAC lookups ──
    // Use arp -an directly (no DNS resolution) — much faster after pingAll
    // populates the cache. We already get hostnames from NetBIOS/PTR.
    let arpTable = {}
    try {
        let arpOut = sys.exec(["arp", "-an"])
        if (arpOut.exitCode == 0) {
            for (line in arpOut.stdout.split("\n")) {
                if (!line.contains(" at ") || line.contains("(incomplete)")) { continue }
                let open = line.indexOf("(")
                let close = line.indexOf(")")
                if (open < 0 || close <= open) { continue }
                let ip = line.slice(open + 1, close)
                let atIdx = line.indexOf(" at ")
                if (atIdx < 0) { continue }
                let afterAt = line.slice(atIdx + 4)
                let sp = afterAt.indexOf(" ")
                let mac = sp >= 0 ? afterAt.slice(0, sp) : afterAt
                arpTable[ip] = mac
            }
        }
    } catch (e) {}
    // Linux: read /proc/net/arp directly
    if (sys.platform == "linux") {
        try {
            let lines = fs.readLines("/proc/net/arp")
            for (i in 1..len(lines)) {
                let parts = lines[i].replacePattern("\\s+", " ").strip().split(" ")
                if (len(parts) >= 4 && parts[3] != "00:00:00:00:00:00") {
                    arpTable[parts[0]] = parts[3]
                }
            }
        } catch (e) {}
    }

    // ── Per-host enrichment + callback ──
    let ordered = []
    for (i in 0..len(ips)) {
        let ip = ips[i]
        let r = results[ip]

        // PTR lookup for ALL hosts without a hostname.
        // Some hosts don't respond to ping or NetBIOS but have DNS records.
        if (r.hostname == "") {
            try {
                let records = net.query(ip, "PTR")
                if (len(records) > 0) {
                    r.hostname = records[0].hostname
                    r.status = "up"
                }
            } catch (e) {
                if (str(e) == "Interrupted") { throw e }
            }
        }

        // ARP MAC from cached table
        if (r.status == "up" && (r.mac == "" || r.mac == "00:00:00:00:00:00")) {
            r.mac = arpTable.get(ip, "")
        }

        push(ordered, r)
        if (onResult) { onResult(r, i) }
    }
    return ordered
}

// High-level scan: parse target, scan all hosts, return results array
func scan(target, opts) {
    let timeout = opts?.timeout ?? 1500
    let iface = opts?.interface ?? nil
    return scanAll(parseRange(target), timeout, iface)
}

export { scan, scanAll, scanHost, parseRange, parseNBSTATResponse }
