// prscan — network scanner library
//
// Usage:
//   use "prscan"
//
//   let results = prscan.scan("192.168.1.0/24", {timeout: 1500})
//   let host = prscan.scanHost("192.168.1.1", 1500)
//
// Each result is a map: {ip, hostname, domain, mac, status}
// status is "up" or "down"

use "hex"
use "arp"

// ── NetBIOS NBSTAT packet ──

let NBSTAT_QUERY = bytes.from([
    0xA0, 0x00,       // Transaction ID
    0x00, 0x00,       // Flags: query
    0x00, 0x01,       // Questions: 1
    0x00, 0x00,       // Answer RRs
    0x00, 0x00,       // Authority RRs
    0x00, 0x00,       // Additional RRs
    0x20,             // Name length (32 encoded bytes)
    0x43, 0x4B,       // "* " encoded
    0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
    0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
    0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
    0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
    0x00,             // Name terminator
    0x00, 0x21,       // Type: NBSTAT
    0x00, 0x01        // Class: IN
])

// ── IP range parsing ──

func parseRange(input) {
    if (input.contains("/")) {
        return parseCIDR(input)
    }
    if (input.contains("-")) {
        let parts = input.split("-")
        let startIp = ipToInt(parts[0].strip())
        let endPart = parts[1].strip()
        let endIp = 0
        if (endPart.contains(".")) {
            endIp = ipToInt(endPart)
        } else {
            let base = parts[0].strip().split(".")
            base[3] = endPart
            endIp = ipToInt(base.join("."))
        }
        return generateRange(startIp, endIp)
    }
    return [input]
}

func ipToInt(ip) {
    let parts = ip.split(".")
    return num(parts[0]) * 16777216 + num(parts[1]) * 65536 + num(parts[2]) * 256 + num(parts[3])
}

func intToIp(n) {
    let a = math.floor(n / 16777216) % 256
    let b = math.floor(n / 65536) % 256
    let c = math.floor(n / 256) % 256
    let d = n % 256
    return str(a) + "." + str(b) + "." + str(c) + "." + str(d)
}

func parseCIDR(cidr) {
    let parts = cidr.split("/")
    let ip = parts[0]
    let prefix = num(parts[1])
    let hostBits = 32 - prefix
    let numHosts = 1 << hostBits
    let baseIp = ipToInt(ip)
    let networkAddr = baseIp & ~(numHosts - 1)
    return generateRange(networkAddr + 1, networkAddr + numHosts - 2)
}

func generateRange(startInt, endInt) {
    let ips = []
    for (i in startInt..endInt + 1) {
        push(ips, intToIp(i))
    }
    return ips
}

// ── NetBIOS response parsing ──

func parseNBSTATResponse(data) {
    let raw = bytes.toArray(data)
    if (len(raw) < 57) { return nil }

    let nameCount = raw[56]
    let names = []
    let offset = 57

    for (i in 0..nameCount) {
        if (offset + 18 > len(raw)) { break }
        let nameBytes = []
        for (j in 0..15) {
            push(nameBytes, raw[offset + j])
        }
        let nameType = raw[offset + 15]
        let flags = raw[offset + 16] * 256 + raw[offset + 17]
        let isGroup = (flags & 0x8000) != 0

        let name = ""
        for (b in nameBytes) {
            if (b >= 32 && b <= 126) { name = name + fromCharCode(b) }
        }
        name = name.strip()

        if (len(name) > 0) {
            push(names, {
                name: name,
                group: isGroup,
                suffix: nameType
            })
        }
        offset = offset + 18
    }

    let mac = ""
    if (offset + 6 <= len(raw)) {
        let macParts = []
        for (j in 0..6) {
            let h = hex.fromInt(raw[offset + j], 2)
            push(macParts, h)
        }
        mac = macParts.join(":")
    }

    let hostname = ""
    let domain = ""
    for (entry in names) {
        if (entry.suffix == 0 && !entry.group && hostname == "") {
            hostname = entry.name
        }
        if (entry.suffix == 0 && entry.group && domain == "") {
            domain = entry.name
        }
    }

    return {
        hostname: hostname,
        domain: domain,
        mac: mac,
        names: names
    }
}

// ── Single-host scanning (kept for backward compat) ──

func scanHost(ip, timeout = 1500, iface = nil) {
    let result = {ip: ip, hostname: "", domain: "", mac: "", status: "down"}

    // Try NetBIOS NBSTAT query
    let sock = nil
    try {
        sock = net.udp()
        if (iface) { net.bindInterface(sock, iface) }
        net.setTimeout(sock, timeout)
        net.sendTo(sock, ip, 137, NBSTAT_QUERY)
        let resp = net.recvFrom(sock)
        net.close(sock)
        sock = nil

        if (resp) {
            let info = parseNBSTATResponse(resp.data)
            if (info) {
                result.hostname = info.hostname
                result.domain = info.domain
                result.mac = info.mac
                result.status = "up"
            }
        }
    } catch (e) {
        if (sock) { try { net.close(sock) } catch (e2) {} }
        if (str(e) == "Interrupted") { throw e }
    }

    // If no NetBIOS response, try reverse DNS via net.query PTR
    if (result.hostname == "") {
        try {
            let records = net.query(ip, "PTR")
            if (len(records) > 0) {
                result.hostname = records[0].hostname
                result.status = "up"
            }
        } catch (e) {
            if (str(e) == "Interrupted") { throw e }
        }
    }

    // Try ARP for MAC if we don't have it (or it's all zeros)
    if ((result.mac == "" || result.mac == "00:00:00:00:00:00") && result.status == "up") {
        result.mac = ""
        try {
            let entry = arp.refresh(ip)
            if (entry) {
                result.mac = entry.mac
                if (result.hostname == "" && entry.hostname != "") {
                    result.hostname = entry.hostname
                }
            }
        } catch (e) {
            if (str(e) == "Interrupted") { throw e }
        }
    }

    return result
}

// ── Concurrent scanning ──
// Scans all IPs in two concurrent phases, then iterates hosts for enrichment:
//   Phase 1: ICMP ping sweep (net.pingAll) — find alive hosts
//   Phase 2: NetBIOS NBSTAT sweep — send all queries, collect responses
//   Per-host: PTR lookup + ARP enrichment (only for alive hosts)
//
// onResult(result, index) is called for each host in order after enrichment.
// onDiscovery() is called when phases 1+2 complete (before per-host iteration).
// Returns array of all results.

func scanAll(ips, timeout = 1500, iface = nil, onResult = nil, onDiscovery = nil) {
    // Initialize result map keyed by IP
    let results = {}
    for (ip in ips) {
        results[ip] = {ip: ip, hostname: "", domain: "", mac: "", status: "down"}
    }

    // ── Phase 1: ICMP ping sweep ──
    try {
        let pings = net.pingAll(ips, timeout)
        for (p in pings) {
            if (p.alive) {
                results[p.host].status = "up"
            }
        }
    } catch (e) {
        if (str(e) == "Interrupted") { throw e }
        // If ping fails (e.g. no permission), continue — NetBIOS may still work
    }

    // ── Phase 2: NetBIOS NBSTAT sweep ──
    // Send to ALL IPs — some hosts block ICMP but respond to NetBIOS
    let sock = nil
    try {
        sock = net.udp()
        if (iface) { net.bindInterface(sock, iface) }
        net.setTimeout(sock, 100)

        for (ip in ips) {
            net.sendTo(sock, ip, 137, NBSTAT_QUERY)
        }

        let start = time.now()
        while (time.now() - start < timeout) {
            let resp = net.recvFrom(sock)
            if (!resp) { continue }
            let info = parseNBSTATResponse(resp.data)
            if (info && results[resp.host]) {
                let r = results[resp.host]
                r.hostname = info.hostname
                r.domain = info.domain
                r.mac = info.mac
                r.status = "up"
            }
        }
        net.close(sock)
        sock = nil
    } catch (e) {
        if (sock) { try { net.close(sock) } catch (e2) {} }
        if (str(e) == "Interrupted") { throw e }
    }

    if (onDiscovery) { onDiscovery() }

    // ── Per-host enrichment + callback ──
    let ordered = []
    for (i in 0..len(ips)) {
        let ip = ips[i]
        let r = results[ip]

        if (r.status == "up") {
            // PTR lookup if no hostname yet
            if (r.hostname == "") {
                try {
                    let records = net.query(ip, "PTR")
                    if (len(records) > 0) { r.hostname = records[0].hostname }
                } catch (e) {
                    if (str(e) == "Interrupted") { throw e }
                }
            }

            // ARP enrichment if no MAC yet
            if (r.mac == "" || r.mac == "00:00:00:00:00:00") {
                r.mac = ""
                try {
                    let entry = arp.refresh(ip)
                    if (entry) {
                        r.mac = entry.mac
                        if (r.hostname == "" && entry.hostname != "") {
                            r.hostname = entry.hostname
                        }
                    }
                } catch (e) {
                    if (str(e) == "Interrupted") { throw e }
                }
            }
        }

        push(ordered, r)
        if (onResult) { onResult(r, i) }
    }
    return ordered
}

// High-level scan: parse target, scan all hosts, return results array
func scan(target, opts) {
    let timeout = 1500
    let iface = nil
    if (opts && opts.timeout) { timeout = opts.timeout }
    if (opts && opts.interface) { iface = opts.interface }
    let ips = parseRange(target)
    return scanAll(ips, timeout, iface)
}

export { scan, scanAll, scanHost, parseRange, parseNBSTATResponse }
