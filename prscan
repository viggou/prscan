#!/usr/bin/env praia
use "args"
use "colors"
use "./grains/scan" as scanner

// ── Version from grain.yaml ──

let _manifest = yaml.parse(sys.read(path.join(path.dirname(sys.currentFile()), "grain.yaml")))
let VERSION = _manifest.version

// ── Argument parsing ──

if (sys.args.contains("--version")) {
    print("prscan v" + VERSION)
    sys.exit(0)
}

let opts = args.parse({
    timeout: {type: "number", short: "t", default: 1500, help: "Timeout per host in ms"},
    verbose: {type: "bool", short: "v", help: "Show all hosts including down ones"},
    quiet: {type: "bool", short: "q", help: "Only show IP and hostname"},
    output: {type: "string", short: "o", help: "Output results to file (.json, .csv, or .txt)"},
    interface: {type: "string", short: "i", help: "Network interface to use (e.g. en0, eth0)"},
    ["no-progress"]: {type: "bool", help: "Hide the progress bar"},
    slow: {type: "bool", help: "Sequential scan (one host at a time)"}
}, sys.args)

let target = nil
if (len(opts.args) > 0) { target = opts.args[0] }
let timeout = opts.timeout
let verbose = opts.verbose
let quiet = opts.quiet
let noProgress = opts["no-progress"]
let outputFile = opts.output
let iface = opts.interface

if (!target) {
    print("Usage: prscan <target> [options]")
    print("")
    print("  target   IP address, range (192.168.1.1-50), or CIDR (192.168.1.0/24)")
    print("")
    print("Options:")
    print("  -t, --timeout <ms>   Timeout per host (default: 1500)")
    print("  -i, --interface <if> Network interface (e.g. en0, eth0)")
    print("  -v, --verbose        Show all hosts including down ones")
    print("  -q, --quiet          Only show IP and hostname")
    print("  --no-progress        Hide the progress bar")
    print("  --slow               Sequential scan (one host at a time)")
    print("  -o, --output <file>  Save results to file (.json, .csv, or .txt)")
    sys.exit(1)
}

let ips = scanner.parseRange(target)

// ── Column layout ──

let termCols = 80
try { termCols = sys.termSize().cols } catch (e) {}
let colIp = 18
let colMac = 20
let colDomain = 16
let colHn = termCols - colIp - colMac - colDomain
if (colHn < 12) { colHn = 12 }

func truncate(s, maxLen) {
    if (len(s) <= maxLen) { return s.padEnd(maxLen) }
    return s.slice(0, maxLen - 1) + "…"
}

func printHeader() {
    if (quiet) { return }
    print("")
    let header = colors.bold("prscan") + " - scanning " + str(len(ips)) + " host(s)"
    if (iface) { header = header + " on " + colors.cyan(iface) }
    print(header)
    print("")
    sys.stdout(colors.dim(
        "IP".padEnd(colIp) +
        "HOSTNAME".padEnd(colHn) +
        "MAC".padEnd(colMac) +
        "DOMAIN"
    ) + "\n")
    sys.stdout(colors.dim("-".repeat(termCols)) + "\n")
}

func printResult(r) {
    if (r.status == "up") {
        if (quiet) {
            let line = r.ip
            if (r.hostname != "") { line = line + "\t" + r.hostname }
            print(line)
        } else {
            let hn = r.hostname != "" ? r.hostname : "—"
            let mc = r.mac != "" ? r.mac : "—"
            let dm = r.domain != "" ? r.domain : "—"
            sys.stdout(
                colors.green(truncate(r.ip, colIp)) +
                colors.bold(truncate(hn, colHn)) +
                truncate(mc, colMac) +
                dm
            )
            print("")
        }
    } elif (verbose && !quiet) {
        sys.stdout(colors.dim(
            r.ip.padEnd(colIp) +
            "—".padEnd(colHn) +
            "—".padEnd(colMac) +
            "—"
        ) + "\n")
    }
}

let found = 0
let cancelled = false
let allResults = []

try {

if (opts.slow || len(ips) == 1) {
    // ── Sequential scan (original behavior) ──
    use "progress"
    printHeader()

    let scanned = 0
    let pb = nil
    if (!quiet && !noProgress) {
        let countStr = str(len(ips)) + "/" + str(len(ips))
        let barWidth = termCols - len(countStr) - 10
        if (barWidth < 10) { barWidth = 10 }
        pb = progress.bar({width: barWidth, showPercent: true, showCount: true})
        pb.total(len(ips))
    }

    for (ip in ips) {
        let result = scanner.scanHost(ip, timeout, iface)
        scanned++
        if (outputFile && (result.status == "up" || verbose)) { push(allResults, result) }
        if (result.status == "up") { found++ }
        if (pb) {
            sys.stdout("\r" + " ".repeat(termCols) + "\r")
            printResult(result)
            pb.update(scanned)
        } else {
            printResult(result)
        }
    }

    if (pb) { sys.stdout("\r" + " ".repeat(termCols) + "\r") }
    if (!quiet) {
        print("")
        let down = scanned - found
        let status = "Hosts scanned: " + str(scanned) + "/" + str(len(ips))
        status = status + " - " + colors.green(str(found) + " up")
        status = status + " - " + colors.red(str(down) + " down")
        print(status)
    }

} else {
    // ── Concurrent scan (default) ──
    if (!quiet && !noProgress) {
        sys.stdout(colors.dim("  discovering hosts...") + "\r")
    }

    let results = scanner.scanAll(ips, timeout, iface)

    // Clear status line and print header + results
    if (!quiet && !noProgress) {
        sys.stdout(" ".repeat(termCols) + "\r")
    }
    printHeader()

    for (r in results) {
        if (outputFile && (r.status == "up" || verbose)) { push(allResults, r) }
        if (r.status == "up") { found++ }
        printResult(r)
    }

    if (!quiet) {
        let down = len(ips) - found
        print("")
        let status = "Hosts scanned: " + str(len(ips)) + "/" + str(len(ips))
        status = status + " - " + colors.green(str(found) + " up")
        status = status + " - " + colors.red(str(down) + " down")
        print(status)
    }
}

} catch (err) {
    cancelled = true
    if (!quiet) {
        print("")
        print(colors.yellow("Scan interrupted"))
    }
}

// Write results to file if --output specified
if (outputFile && len(allResults) > 0) {
    let ext = ""
    let dotIdx = outputFile.lastIndexOf(".")
    if (dotIdx >= 0) { ext = outputFile.slice(dotIdx, len(outputFile)).lower() }

    let content = ""
    if (ext == ".json") {
        content = json.stringify(allResults, 2)
    } elif (ext == ".csv") {
        content = "ip,hostname,domain,mac,status\n"
        for (r in allResults) {
            content = content + r.ip + "," + r.hostname + "," + r.domain + "," + r.mac + "," + r.status + "\n"
        }
    } else {
        for (r in allResults) {
            let line = r.ip
            if (r.hostname != "") { line = line + "\t" + r.hostname }
            if (r.mac != "") { line = line + "\t" + r.mac }
            if (r.domain != "") { line = line + "\t" + r.domain }
            line = line + "\t" + r.status
            content = content + line + "\n"
        }
    }

    sys.write(outputFile, content)
    if (!quiet) {
        print(colors.dim("Results written to " + outputFile))
    }
}
